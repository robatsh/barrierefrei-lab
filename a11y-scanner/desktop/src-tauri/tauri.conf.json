{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A11y Scanner",
  "version": "0.1.0",
  "identifier": "org.example.a11yscanner",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "A11y Scanner", "width": 1180, "height": 850, "minWidth": 750, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": false }
}
